@startuml C3_Вариант2_Благополучие
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C3 - Вариант 2. Компоненты сервиса "Благополучие животных" (в центре, на все фермы)

ContainerQueue_Ext(kafka, "Apache Kafka", "Kafka", "События детекции со ВСЕХ ферм")
Container_Ext(inference2, "Кластер инференса", "Triton, GPU-ферма", "Обрабатывает потоки всех ферм")
Container_Ext(notify2, "Сервис оповещений", "Go", "Команды уходят обратно на фермы")
Container_Ext(fleet2, "Управление парком", "Kotlin", "Реестр ферм и шлюзов, состояние связи")
Container_Ext(gateway2, "API Gateway", "Kong", "Запросы от веб и мобильного приложений")
ContainerDb_Ext(coredb2, "Мастер-БД", "PostgreSQL", "Инциденты всех ферм, правила, дежурства")
ContainerDb_Ext(minio2, "MinIO", "MinIO", "Видеофрагменты всех ферм")

Container_Boundary(welfare2, "Сервис благополучия животных (Kotlin + Spring, кластер)") {

    Component(consumer2, "Обработчик событий детекции", "Kafka Consumer", "Читает партиции. Ключ партиционирования - идентификатор фермы, чтобы события одной фермы шли по порядку")

    Component(tenant, "Маршрутизатор ферм", "Kotlin", "НОВЫЙ компонент. Определяет, к какой ферме относится событие, подтягивает её настройки, изолирует данные ферм друг от друга")

    Component(registry2, "Реестр типов инцидентов", "Kotlin, БД", "Справочник типов. Общий для всех ферм, но пороги могут переопределяться на уровне фермы")

    Component(scorer2, "Оценщик достоверности", "Kotlin", "Пороги по типу, времени суток и КОНКРЕТНОЙ ферме")

    Component(aggregator2, "Агрегатор инцидентов", "Kotlin", "Окно корреляции. Усложнён: события могли прийти пачкой после восстановления связи, время прибытия не равно времени события")

    Component(latecheck, "Контроль опоздавших событий", "Kotlin", "НОВЫЙ компонент. Событие пришло из буфера шлюза через 2 часа. Реагировать сиреной уже поздно - помечает как исторические, не эскалирует")

    Component(conncheck, "Контроль связи с фермой", "Kotlin", "НОВЫЙ компонент. Проверяет, доступен ли шлюз, прежде чем слать команду на сирену. Если нет - переключает на SMS")

    Component(fsm2, "Машина состояний инцидента", "Kotlin", "Новый -> Отправлен -> Подтверждён -> В работе -> Закрыт")

    Component(escalation2, "Политика эскалации", "Kotlin", "График дежурств по каждой ферме, роли, критичность")

    Component(evidence2, "Сборщик доказательств", "Kotlin", "Забирает видеофрагмент из общего хранилища по идентификатору фермы и камеры")

    Component(repo2, "Репозиторий инцидентов", "Spring Data JPA", "Инциденты всех ферм. Обязательная фильтрация по ферме в каждом запросе")

    Component(api2, "Внутренний API", "Spring REST", "Список инцидентов, подтверждение, диагноз. Проверка прав на конкретную ферму")

    Component(metrics2, "Экспортёр метрик", "Micrometer + OTel", "Метрики в разрезе ферм")
}

Rel(inference2, kafka, "События детекции всех ферм", "Kafka")
Rel(kafka, consumer2, "События детекции", "Kafka")
Rel(consumer2, tenant, "Событие + идентификатор фермы")
Rel(tenant, fleet2, "Настройки фермы и состояние связи", "REST")
Rel(tenant, latecheck, "Событие с меткой времени")
Rel(latecheck, scorer2, "Актуальное событие")
Rel(latecheck, repo2, "Опоздавшее - только в историю")
Rel(scorer2, registry2, "Порог для типа и фермы")
Rel(scorer2, aggregator2, "Прошло порог")
Rel(aggregator2, fsm2, "Инцидент")
Rel(fsm2, evidence2, "Нужно доказательство")
Rel(evidence2, minio2, "Видеофрагмент", "S3")
Rel(fsm2, repo2, "Сохраняет")
Rel(fsm2, escalation2, "Требует реакции")
Rel(escalation2, conncheck, "Проверить канал до фермы")
Rel(conncheck, notify2, "Канал выбран: сирена или SMS", "Kafka")
Rel(escalation2, repo2, "График дежурств")
Rel(repo2, coredb2, "Читает и пишет", "SQL")
Rel(registry2, coredb2, "Справочник", "SQL")
Rel(gateway2, api2, "Запросы", "REST")
Rel(api2, repo2, "Читает инциденты")
Rel(api2, fsm2, "Подтверждение, диагноз")
Rel(metrics2, coredb2, "Счётчики", "SQL")

@enduml
