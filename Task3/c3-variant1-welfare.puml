@startuml C3_Вариант1_Благополучие
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C3 - Вариант 1. Компоненты сервиса "Благополучие животных" (на ферменном агенте)

ContainerQueue_Ext(mqtt, "Локальная шина", "RabbitMQ", "События детекции")
Container_Ext(inference, "Сервис инференса", "Python + Triton", "Присылает события детекции")
Container_Ext(notify, "Сервис оповещений", "Go", "Сирена, SMS, локальный UI")
Container_Ext(sync, "Сервис синхронизации", "Go", "Отправка в центр")
Container_Ext(localapi, "Локальный API", "Kotlin", "Запросы от оператора и ветеринара")
ContainerDb_Ext(localdb, "Локальная БД", "PostgreSQL + TimescaleDB", "Инциденты, правила, дежурства")
ContainerDb_Ext(localblob, "Локальное хранилище", "MinIO", "Видеофрагменты")

Container_Boundary(welfare, "Сервис благополучия животных (Kotlin + Spring)") {

    Component(consumer, "Обработчик событий детекции", "Spring AMQP Listener", "Принимает события из шины, валидирует схему, отбрасывает мусор")

    Component(registry, "Реестр типов инцидентов", "Kotlin, конфиг + БД", "Справочник типов: драка, задавливание, болезнь, беспокойство. Новый тип добавляется записью, а не правкой кода")

    Component(scorer, "Оценщик достоверности", "Kotlin", "Проверяет уверенность модели против порога типа. Пороги зависят от типа, времени суток и камеры")

    Component(aggregator, "Агрегатор инцидентов", "Kotlin", "Окно корреляции: множество детекций одного события в одном загоне сливает в ОДИН инцидент. Подавляет дубли")

    Component(fsm, "Машина состояний инцидента", "Kotlin", "Новый -> Отправлен -> Подтверждён оператором -> В работе -> Закрыт. Повторная эскалация если не подтвердили")

    Component(escalation, "Политика эскалации", "Kotlin", "Кого и как звать: график дежурств, роль, время суток, критичность. Повтор через N минут")

    Component(evidence, "Сборщик доказательств", "Kotlin", "Запрашивает видеофрагмент вокруг момента инцидента, прикрепляет к карточке")

    Component(repo, "Репозиторий инцидентов", "Spring Data JPA", "Чтение и запись инцидентов, правил, дежурств")

    Component(outbox, "Издатель outbox", "Kotlin", "Пишет событие в таблицу outbox в ОДНОЙ транзакции с инцидентом. Гарантия доставки в центр")

    Component(api, "Внутренний API", "Spring REST", "Список инцидентов, подтверждение, простановка диагноза")

    Component(metrics, "Экспортёр метрик", "Micrometer + OpenTelemetry", "Метрики инцидентов. Собственные метрики подключаются как плагины")
}

' ===== ВХОД =====
Rel(inference, mqtt, "Событие детекции", "AMQP")
Rel(mqtt, consumer, "Событие детекции", "AMQP")

' ===== КОНВЕЙЕР ОБРАБОТКИ =====
Rel(consumer, scorer, "Валидное событие")
Rel(scorer, registry, "Запрашивает порог для типа")
Rel(scorer, aggregator, "Событие прошло порог")
Rel(aggregator, fsm, "Новый или обновлённый инцидент")
Rel(fsm, evidence, "Нужно доказательство")
Rel(evidence, localblob, "Забирает видеофрагмент", "S3")
Rel(fsm, repo, "Сохраняет состояние")
Rel(fsm, escalation, "Инцидент требует реакции")
Rel(escalation, repo, "Читает график дежурств")
Rel(escalation, notify, "Кого звать и по каким каналам", "AMQP")

' ===== ХРАНЕНИЕ И СИНХРОНИЗАЦИЯ =====
Rel(repo, localdb, "Читает и пишет", "SQL")
Rel(registry, localdb, "Загружает справочник типов и правил", "SQL")
Rel(fsm, outbox, "Событие для центра")
Rel(outbox, localdb, "Пишет в таблицу outbox в одной транзакции", "SQL")
Rel(sync, localdb, "Вычитывает outbox", "SQL")

' ===== ЗАПРОСЫ ОТ ЛЮДЕЙ =====
Rel(localapi, api, "Запросы оператора и ветеринара", "REST")
Rel(api, repo, "Читает инциденты")
Rel(api, fsm, "Подтверждение тревоги, простановка диагноза")
Rel(metrics, localdb, "Читает счётчики", "SQL")

@enduml
