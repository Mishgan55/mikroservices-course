@startuml C1_Вариант1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C1 - Вариант 1: "Автономная ферма, тонкий центр"

' ===== ЛЮДИ =====
Person(operator, "Оператор фермы", "Дежурный. Реагирует на тревоги на месте")
Person(vet, "Ветеринарный врач", "Ставит диагноз, назначает лечение")
Person(admin, "Администратор", "Заводит фермы и оборудование, управляет доступами")
Person(director, "Директор хозяйства", "Смотрит сводки по всем фермам")
Person(analyst, "Аналитик", "Строит отчёты в BI")

' ===== НАШИ СИСТЕМЫ: ДВЕ =====
System(agent, "Ферменный агент", "На КАЖДОЙ ферме. Видеоаналитика, алертинг, кормление. Работает без интернета")
System(core, "Центральная платформа", "Агрегация по всем фермам, история, API, раздача моделей")

' ===== ОБОРУДОВАНИЕ НА ФЕРМЕ =====
System_Ext(cameras, "IP-камеры (разные вендоры)", "Видеопоток загонов, ночной режим. ONVIF/RTSP")
System_Ext(feeders, "Кормушки и поилки (разные вендоры)", "Дозирование корма и воды. Modbus")
System_Ext(water, "Станции водоподготовки", "Фильтры, датчики качества воды. Modbus TCP")
System_Ext(siren, "Сирена и световое табло", "Локальное оповещение в свинарнике")
System_Ext(sms, "GSM/SMS-шлюз", "Резервный канал, работает без интернета")

' ===== ВНЕШНИЕ СИСТЕМЫ =====
System_Ext(idp, "Keycloak (IdP)", "Аутентификация и авторизация. OAuth2/OIDC")
System_Ext(mlrepo, "Репозиторий ML-моделей партнёра", "Готовые модели детекции поведения")
System_Ext(erp, "1С:Агро (ERP)", "Склад кормов, финансы, кадры")
System_Ext(dwh, "Корпоративные DWH + BI", "ClickHouse, Power BI")
System_Ext(monitoring, "Корпоративный мониторинг", "Prometheus/Zabbix")

' ===== КЛЮЧЕВОЕ: оператор и ветеринар работают С АГЕНТОМ, локально =====
Rel(agent, operator, "Тревога за 5 сек: сирена, SMS, локальный UI")
Rel(operator, agent, "Подтверждает и закрывает тревоги", "локальная сеть")
Rel(vet, agent, "Смотрит подозрения на болезнь, ставит диагноз", "локальная сеть")

' ===== АГЕНТ И ОБОРУДОВАНИЕ =====
Rel(cameras, agent, "Видеопоток", "RTSP")
Rel(agent, feeders, "Команды кормления и поения", "Modbus")
Rel(feeders, agent, "Телеметрия расхода", "Modbus")
Rel(water, agent, "Состояние фильтров, качество воды", "Modbus TCP")
Rel(agent, siren, "Включает локальную тревогу", "реле")
Rel(agent, sms, "SMS дежурному при обрыве связи", "AT-команды")

' ===== СИНХРОНИЗАЦИЯ (допустима задержка до 10 минут) =====
Rel(agent, core, "Синхронизация событий и телеметрии, задержка до 10 мин", "HTTPS/MQTT")
Rel(core, agent, "Раздаёт конфигурацию и новые ML-модели", "HTTPS")

' ===== ЦЕНТР И ОСТАЛЬНОЙ МИР =====
Rel(admin, core, "Настраивает фермы и оборудование")
Rel(director, core, "Смотрит сводные показатели")
Rel(analyst, dwh, "Строит отчёты")
Rel(core, idp, "Проверяет токены и роли", "OIDC")
Rel(mlrepo, core, "Поставляет обученные модели", "HTTPS")
Rel(core, erp, "Списание корма, данные о поголовье", "REST API")
Rel(core, dwh, "Выгрузка событий и телеметрии", "Kafka / batch")
Rel(core, monitoring, "Отдаёт метрики", "Prometheus exposition")

@enduml
